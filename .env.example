# Chitti Environment Configuration

# Application
NODE_ENV=development
APP_NAME=Chitti
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/chitti

# Authentication
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_PROVIDER=local

# Notifications
SMS_PROVIDER=
WHATSAPP_PROVIDER=
EMAIL_PROVIDER=

# Logging
LOG_LEVEL=debug
